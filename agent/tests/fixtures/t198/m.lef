    PORT
      LAYER M4 ;
        RECT 0 7 0.5 7.1 ;
    END
  END din
  PIN dout
    DIRECTION OUTPUT ;
    USE SIGNAL ;
    PORT
      LAYER M4 ;
        RECT 0 12 0.5 12.1 ;
    END
  END dout
  OBS
    LAYER M1 ;
      RECT 0 0 20 20 ;
  END
END FAKEM2
END LIBRARY
